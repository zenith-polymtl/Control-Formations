# syntax=docker/dockerfile:1.6
# Même base que l'image de B2, plus trois paquets pour les exemples de B3 (voir B3.1, section 1).
ARG ROS_DISTRO=humble
#Image de base ros2, multiplateforme (amd64, arm64)
FROM --platform=$TARGETPLATFORM ros:${ROS_DISTRO}-ros-base

ENV DEBIAN_FRONTEND=noninteractive

#Configuration du shell
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

#Installation de mavros, python
RUN apt-get update && apt-get install -y \
    ros-${ROS_DISTRO}-mavros \
    ros-${ROS_DISTRO}-mavros-extras \
    ros-${ROS_DISTRO}-mavlink \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    geographiclib-tools \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

#Script qui installe les datasets (dépendances) pour mavros
RUN /opt/ros/${ROS_DISTRO}/lib/mavros/install_geographiclib_datasets.sh

#Ajouts B3 : nodes de démonstration talker/listener (C++ et Python) et rqt_graph.
#L'image ros-base ne les contient pas, contrairement à une installation "desktop".
#Placés après mavros pour que le cache de B2 soit réutilisé autant que possible.
RUN apt-get update && apt-get install -y \
    ros-${ROS_DISTRO}-demo-nodes-cpp \
    ros-${ROS_DISTRO}-demo-nodes-py \
    ros-${ROS_DISTRO}-rqt-graph \
    && rm -rf /var/lib/apt/lists/*

#librairies python
RUN pip3 install --no-cache-dir \
    numpy

#Dossier de référence du docker
WORKDIR /example_ws


#Autorisations et accès essentiels
ARG UID=1000
ARG GID=1000

RUN groupadd -g ${GID} dev \
    && useradd -m -u ${UID} -g ${GID} -s /bin/bash dev

RUN usermod -aG dialout dev

USER dev

#Ajout B3 : les shells interactifs sourcent ROS 2 et le workspace (s'il est bâti).
#Le Makefile source déjà l'environnement, mais la complétion par Tab des commandes
#ros2 et colcon ne survit pas au "exec bash -i" : elle doit être rechargée ici.
RUN echo 'source /opt/ros/humble/setup.bash' >> /home/dev/.bashrc \
    && echo 'if [ -f /example_ws/install/setup.bash ]; then source /example_ws/install/setup.bash; fi' >> /home/dev/.bashrc
